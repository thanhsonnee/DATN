# Copy sang .env.local rồi sửa IP LAN của máy đang chạy backend.
# Điện thoại thật và máy tính phải CÙNG mạng Wi-Fi — không dùng được "localhost"
# vì đó là loopback của chính điện thoại, không phải của máy tính.
# Xem IP LAN: Windows chạy `ipconfig` (mục "IPv4 Address" của Wi-Fi đang dùng).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080/api/v1
